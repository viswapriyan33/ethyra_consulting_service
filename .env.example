# ==========================================
# ETHYRA Impact - Email Configuration (Gmail SMTP)
# ==========================================

# 1. Your Google/Gmail address
GMAIL_USER=your_email@gmail.com

# 2. Google App Password (16 characters)
# How to generate:
# - Go to your Google Account: https://myaccount.google.com/security
# - Turn on 2-Step Verification (if not already enabled)
# - Search or navigate to "App passwords" (https://myaccount.google.com/apppasswords)
# - Enter an app name (e.g. "ETHYRA Impact") and click Create
# - Copy the generated 16-letter password (e.g. "abcd efgh ijkl mnop") and paste below:
GMAIL_APP_PASSWORD=your_16_character_app_password

# 3. Notification Recipients
ADMIN_EMAIL=connect@ethyra.in

# 4. Admin Credentials
VITE_ADMIN_EMAIL=connect@ethyra.in
VITE_ADMIN_PASSWORD=your_admin_password_here

